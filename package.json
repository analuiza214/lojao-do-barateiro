{
  "name": "lojao-do-barateiro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build:catalog": "node scripts/gen-catalog-json.mjs",
    "build:worker": "node build-worker.mjs",
    "build:deploy": "node scripts/prepare-deploy.mjs",
    "build": "node scripts/gen-catalog-json.mjs && node build-worker.mjs && node scripts/prepare-deploy.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^3.114.0"
  }
}
