{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lojao-do-barateiro",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
